# Credenciales de Supabase. Copia esto a `.env` (gitignorado) y rellena.
#
# El SDK busca el fichero en ESTE repo y, si no está, en su carpeta padre. Lo segundo
# permite un único `.env` compartido por varios proyectos del hackathon.
#
# Sin esto la simulación corre igual y escribe en `runs/`; lo que no podrá es subir, y lo
# dice en voz alta al arrancar en vez de tragárselo en silencio. Con credenciales sube por
# defecto: para no subir, `--no-telemetry`.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# SECRETA: se salta el RLS y es la única que puede escribir. Solo el lado Python,
# nunca en un frontend.
SUPABASE_SERVICE_KEY=eyJ...
